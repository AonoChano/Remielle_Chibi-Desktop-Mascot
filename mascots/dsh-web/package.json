{
  "name": "@aonochano/remi-pet-dsh",
  "version": "0.1.0",
  "description": "Remielle chibi Spine pet for the DeepSeek Harness web page — a dual-face Cordis plugin (node half serves Spine assets, browser half renders the pet into the shell.overlay slot)",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepare": "node build.mjs",
    "test": "node test/run-tests.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "spine",
    "desktop-pet",
    "mascot",
    "web"
  ],
  "author": "Watanabe Satoru (AonoChano)",
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@esotericsoftware/spine-webgl": "~4.2.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "react": "^18.2.0",
    "rollup": "^4.9.0"
  }
}
