{
  "name": "remeille-desktop-mascot",
  "version": "0.1.0",
  "description": "Remielle Chibi Desktop Mascot - Electron Desktop Pet",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "prebuild": "electron-builder --dir",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.aonochano.remielle-mascot",
    "productName": "Remielle Desktop Mascot",
    "files": [
      "**/*",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../../spine/remeille-chibi",
        "to": "spine-assets",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "keywords": ["spine", "desktop-pet", "mascot", "electron", "bongo-cat", "zenless-zone-zero", "remielle"],
  "author": "AonoChano",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "@esotericsoftware/spine-webgl": "~4.2.0"
  }
}
